algoritmo "Subtracao"
var
   contador, subtracao, decremento: inteiro
inicio
         escreva("De onde iniciar a subtracao? ")
         leia(contador)
         
         decremento <- 50
         
         enquanto (contador > 0) faca
                  escreval(contador)
                  contador <- contador - decremento
         fimenquanto
      
fimalgoritmo
